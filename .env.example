# === LLM ===
GROQ_API_KEY=your-groq-api-key-here
# Get free key at https://console.groq.com

# === Event Sources ===
# Leave blank for sources you haven't set up yet — the pipeline skips unconfigured sources
LUMA_API_KEY=
EVENTBRITE_API_KEY=
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
YELP_API_KEY=
SEATGEEK_CLIENT_ID=

# === Knowledge Graph (Cognee) ===
# Cognee uses local storage by default; these are optional overrides
# COGNEE_GRAPH_STORE=kuzu  # kuzu (default), neo4j, falkordb
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# === Supabase (Database & Auth) ===
# Create a free project at https://supabase.com
# Then run the SQL schema from app/db.py SCHEMA_SQL in the SQL Editor
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
# For Google OAuth: enable Google provider in Supabase Auth settings
# and configure OAuth credentials in Google Cloud Console

# === App ===
APP_ENV=development
APP_PORT=8000
CITY=bay-area

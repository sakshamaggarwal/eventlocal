# === LLM ===
GROQ_API_KEY=your-groq-api-key-here
# Get free key at https://console.groq.com

# === Event Sources ===
# Leave blank for sources you haven't set up yet
LUMA_API_KEY=
EVENTBRITE_API_KEY=
GOOGLE_PLACES_API_KEY=

# === Knowledge Graph (Cognee) ===
# Cognee uses local storage by default; these are optional overrides
# COGNEE_GRAPH_STORE=kuzu  # kuzu (default), neo4j, falkordb
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# === App ===
APP_ENV=development
APP_PORT=8000
CITY=bay-area
